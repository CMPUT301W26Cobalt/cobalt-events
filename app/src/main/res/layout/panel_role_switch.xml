<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_rounded"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:elevation="12dp">

    <!-- Header label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Switch Role"
        android:textSize="11sp"
        android:textColor="#9CA3AF"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp" />

    <!-- Switch to User -->
    <LinearLayout
        android:id="@+id/panelBtnSwitchToEntrant"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_account_mode_icon_well_user"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_account_mode_user"
                android:contentDescription="User" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue as User"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse &amp; join events"
                android:textSize="12sp"
                android:textColor="#9CA3AF" />
        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F3F4F6"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Switch to Organizer -->
    <LinearLayout
        android:id="@+id/panelBtnSwitchToOrganizer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="?android:attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_account_mode_icon_well_user"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_account_mode_organizer_neutral"
                android:contentDescription="Organizer" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue as Organizer"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create &amp; manage events"
                android:textSize="12sp"
                android:textColor="#9CA3AF" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>