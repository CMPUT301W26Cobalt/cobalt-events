<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_event_comments_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="4dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="10dp"
        android:background="@color/grey_border_light" />

    <LinearLayout
        android:id="@+id/layout_comments_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/comments_section_title"
            android:src="@drawable/ic_comment_bubble" />

        <TextView
            android:id="@+id/tv_comments_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/comments_section_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_comments_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tv_comments_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="4dp"
        android:textColor="@color/header_teal"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tv_comment_input_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="Y"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/brand_mint_text"
            android:background="@drawable/bg_comment_avatar_circle" />

        <EditText
            android:id="@+id/et_comment_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minLines="2"
            android:maxLines="5"
            android:gravity="top|start"
            android:hint="@string/comment_input_hint"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/grey_hint_text"
            android:background="@drawable/bg_input_rounded_light"
            android:padding="10dp"
            android:inputType="textCapSentences|textMultiLine" />

        <ImageButton
            android:id="@+id/btn_send_comment"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_comment_send"
            android:contentDescription="@string/send_comment"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_send_arrow"
            app:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
