<?xml version="1.0" encoding="utf-8"?>
<!-- Selected radio on neutral (white) row — green ring + dot -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:width="24dp"
                android:height="24dp" />
            <stroke
                android:width="2dp"
                android:color="@color/account_mode_green" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="10dp"
        android:height="10dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/account_mode_green" />
        </shape>
    </item>
</layer-list>
