@startuml
title Cobalt Events - Architecture Overview

skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam defaultTextAlignment left
'
' SVG export (use: plantuml.jar -tsvg this file) — vector output stays sharp at any zoom.
' dpi + scale enlarge coordinate space / stroke detail; not raster pixels like PNG.
skinparam svgDimensionStyle false
skinparam dpi 300
scale 1.6

' ------------------------------------------------------------------------------
' Legend
' ------------------------------------------------------------------------------
legend left
  + public    # protected    - private
  Dependencies show high-level "uses" relationships only (not every call).
  Comments explain intent, constraints, and noteworthy design decisions.
endlegend

' ==============================================================================
' Packages
' ==============================================================================
package "com.example.cobaltevents.model" as model {
  ' Firestore-serializable POJOs used across DB and UI layers.
  class Event {
    +eventId: String
    +name: String
    +description: String
    +location: String
    +locationLatitude: Double
    +locationLongitude: Double
    +price: String
    +eventDate: Timestamp
    +registrationOpen: Timestamp
    +registrationClose: Timestamp
    +organizers: List<String>
    +waitingListId: String
    +posterImageUrl: String
    +geolocationRequired: boolean
    +waitingListCapacity: int
    +qrCodeData: String
    +confirmedAttendeeIds: List<String>
    +category: Object
    +ageGroup: String
    +criteria: String
    +isPrivate: boolean
    --
    +isDeviceAnOrganizer(deviceId)
    +isSoleOrganizer(deviceId)
  }

  class WaitingList {
    +id: String
    +eventId: String
    +deviceId: String
    +status: String
    +registeredAt: Timestamp
    +note: String
    +numParticipants: int
    +name: String
    +email: String
    +phone: String
    +notificationMethod: String
    +notificationsAllowed: boolean
    --
    +STATUS_* (pending, selected, enrolled, declined, …)
  }

  class WaitlistEntryInfo {
    +status: String
    +notificationsAllowed: boolean
  }

  class Notification {
    +id: String
    +recipientId: String
    +eventId: String
    +title: String
    +message: String
    +type: String
    +read: String
    +timestamp: Date
    +recipient_mode: String
    --
    +TYPE_SELECTED, TYPE_GOT_OFF_WAITLIST, TYPE_NOT_SELECTED
    +TYPE_PRIVATE_EVENT, TYPE_CO_ORGANIZER, TYPE_EVENT_ALERT
    +RECIPIENT_MODE_USER, RECIPIENT_MODE_ORGANIZER
  }

  class Entrant {
    +deviceId: String
    +name: String
    +email: String
    +phone: String
    +profilePictureUrl: String
    +organizerEnabled: Boolean
  }

  class Comment {
    +id: String
    +eventId: String
    +userId: String
    +userName: String
    +text: String
    +createdAtMillis: long
    +reactions: Map
    +replies: List<Reply>
  }

  class Reply {
    +id: String
    +commentId: String
    +userId: String
    +userName: String
    +text: String
    +createdAtMillis: long
    +reactions: Map
  }

  class Organizer
}

package "com.example.cobaltevents.db" as db {
  ' Firestore/Storage access. No UI logic; async callbacks only.
  class EventDB {
    +createEvent(event, onSuccess, onFailure)
    +getEvent(eventId, onSuccess, onFailure)
    +getEventFromServer(eventId, onSuccess, onFailure)
    +getAllEvents(onSuccess, onFailure, cacheFallback?)
    +getEventsByOrganizer(deviceId, onSuccess, onFailure)
    +getEventsForOrganizerParticipation(deviceId, onSuccess, onFailure)
    +updateEvent(event, onSuccess, onFailure)
    +deleteEvent(eventId, onSuccess, onFailure)
    +removeOrganizerEnsuringAtLeastOne(eventId, deviceId, …)
    --
    ..catalog prefers server read; optional cache fallback..
  }
  class WaitingListDB {
    +getEntrantsForEvent(eventId, source, onSuccess, onFailure)
    +addRegistration(…)
    +getActiveRegistrationForEvent(…)
    +getRegistrationForEventAnyStatus(…)
    +updateStatus(…)
    +deleteAllWaitlistDataForEvent(eventId, …)
    +getActiveCountForEvent(…)
    +removeUserFromAllWaitlists(deviceId, …)
    +transactions for capacity / atomic updates
  }
  class NotificationDB {
    +saveNotification(notification, onSuccess, onFailure)
    +deleteNotification(notificationId, onSuccess, onFailure)
    +getNotificationsForRecipient(recipientId, onSuccess, onFailure)
    +listenForNotifications(recipientId, listener)
    +updateReadStatus(notificationId, readStatus, onSuccess, onFailure)
  }
  class ProfileDB {
    +saveProfile(entrant, onSuccess, onFailure)
    +setOrganizerEnabled(deviceId, enabled, onSuccess, onFailure)
    +getProfile(deviceId, onSuccess, onFailure)
    +getAllProfiles(onSuccess, onFailure)
    +deleteProfile(deviceId, onSuccess, onFailure)
  }
  class ImageDB {
    +uploadProfileImage(imageUri, onSuccess, onFailure)
    +uploadPoster(imageUri, eventId, onSuccess, onFailure)
    +deleteImageByUrl(imageUrl, onSuccess, onFailure)
  }
  class CommentDB {
    +loadCommentsForEvent(eventId, viewerUserId, …)
    +addComment, addReply, toggle reactions
    +deleteCommentWithReplies(…)
    +deleteAllCommentsAndRepliesForEvent(eventId, …)
    --
    ..events/{id}/comments and …/replies subcollections..
  }
  class EventDBConnector {
    +getInstance(): EventDBConnector
    +getFirestore(): FirebaseFirestore
  }
  class EntrantDB {
    +saveEntrant(entrant)
    +getEntrant(): Entrant
    +clearEntrant()
  }
}

package "com.example.cobaltevents.controller" as ctl {
  ' Orchestration and domain logic; coordinates DB operations for UI.
  class EventController {
    +createEvent(event, onSuccess, onFailure)
    +getAllEvents(onSuccess, onFailure, cacheFallback?)
    +getEvent(eventId, onSuccess, onFailure)
    +getEventFromServer(eventId, onSuccess, onFailure)
    +getEventsByOrganizer(organizerDeviceId, onSuccess, onFailure)
    +updateEvent(event, onSuccess, onFailure)
    +deleteEvent(eventId, onSuccess, onFailure)
  }
  class EntrantController {
    +validateName(name): String?
    +validateEmail(email): String?
    +validatePhone(phone): String?
    +saveEntrant(entrant): boolean
  }
  class AdminController {
    +invalidateAll()
    +getAllEvents / getAllProfiles (session caches)
    +removeEvent(eventId, …) + event-alert notifications
    +removeProfile(deviceId, …)
    +removeOrganizer(organizerDeviceId, …)
    +removeEventImage(eventId, posterUrlWhenListed, …)
    +getAllImagesFromEvents, getAllOrganizers
    +getAllNotifications
    +getAllCommentsGroupedByEvent, removeComment, removeReply
    --
    ..removeOrganizer: event-side cleanup only (no profile delete)..
    ..removeEventImage: transactional if poster URL still matches..
  }
  class LotteryController {
    +acceptInvitation / declineInvitation / draw replacement flows
    --
    ..updates WaitingListDB; coordinates notifications..
  }
  class NotificationController {
    +createNotificationChannel(context)
    +requestNotificationPermission(activity)
    +sendSelectedNotification(entrantId, eventId, eventName)
    +startNotificationListener(context, deviceId)
    +stopNotificationListener()
    --
    ..tap opens NotificationsActivity..
  }
  class QRCodeController {
    +generateQRCode(eventId): Bitmap
    +generateQRCodeData(eventId): String
  }
  class ImageController {
    +uploadPoster(imageUri, event, onSuccess, onFailure)
  }
  class OrganizerController
  class GeolocationController
}

package "com.example.cobaltevents.ui" as ui {
  ' Primary screens (Activities). Delegate to controllers / DB.
  class MainActivity
  class WelcomeActivity
  class EventListActivity
  class EventCreateActivity
  class EventManageActivity
  class EventHistoryActivity
  class JoinWaitlistActivity
  class QRScanActivity
  class EntrantActivity
  class EntrantEditActivity
  class OrganizerActivity
  class AccountSettingsActivity
  class NotificationsActivity
  class MapPreviewActivity
  class EditEventDialog
  ' Also: EditFieldActivity, EditLocationActivity, EditCapacityActivity, etc. for inline edits.
}

package "com.example.cobaltevents.ui.admin" as uiAdmin {
  class AdminActivity
  class AdminCommentsActivity
  class AdminAdapter
  class AdminConfig
  class AdminEventListActivity
  class AdminProfileListActivity
  class AdminImageListActivity
  ' AdminEvent/Profile/Image list activities: placeholder shells; main browse is AdminActivity.
}

package "com.example.cobaltevents.ui.comments" as uicomments {
  class EventCommentsUiBinder
  note bottom of EventCommentsUiBinder
    Event card comments: load via CommentDB; server check for private/stale event on writes.
  end note
}

package "com.example.cobaltevents.ui.adapter" as adapter {
  class EventAdapter
  class OrganizerEventAdapter
  class EventHistoryAdapter
  class WaitlistEntrantAdapter
  class NotificationListAdapter
}

' ==============================================================================
' Relationships (high-level)
' ==============================================================================
db.EventDBConnector --> db.EventDB : provides Firestore
db.EventDBConnector --> db.CommentDB : provides Firestore
ctl.EventController --> db.EventDB
ctl.EntrantController --> db.EntrantDB
ctl.EntrantController --> db.ProfileDB
ctl.AdminController --> db.EventDB
ctl.AdminController --> db.ProfileDB
ctl.AdminController --> db.WaitingListDB
ctl.AdminController --> db.NotificationDB
ctl.AdminController --> db.CommentDB
ctl.AdminController ..> model.Event : caches
ctl.AdminController ..> model.Entrant : caches
ctl.ImageController --> db.ImageDB
ctl.ImageController --> db.EventDB
ctl.LotteryController --> db.WaitingListDB
ctl.LotteryController --> db.EventDB
ctl.LotteryController --> db.NotificationDB
ctl.NotificationController --> db.NotificationDB
ctl.QRCodeController ..> model.Event : generates QR from eventId

db.EventDB --> model.Event
db.WaitingListDB --> model.WaitingList
db.WaitingListDB ..> model.WaitlistEntryInfo
db.NotificationDB --> model.Notification
db.ProfileDB --> model.Entrant
db.ImageDB ..> model.Event : persists poster URL
db.EntrantDB --> model.Entrant
db.CommentDB --> model.Comment
db.CommentDB --> model.Reply
model.Comment *-- model.Reply : nested in memory

ui.MainActivity ..> ctl.NotificationController : start/stop listener
ui.EventListActivity ..> ctl.EventController
ui.EventListActivity ..> ctl.GeolocationController
ui.EventCreateActivity ..> ctl.EventController
ui.EventManageActivity ..> ctl.EventController
ui.EventManageActivity ..> ctl.ImageController
ui.EventManageActivity ..> ctl.LotteryController
ui.EventManageActivity ..> ctl.QRCodeController
ui.EventHistoryActivity ..> ctl.EventController
ui.JoinWaitlistActivity ..> db.WaitingListDB
ui.QRScanActivity ..> db.EventDB
ui.QRScanActivity ..> db.WaitingListDB
ui.QRScanActivity ..> ctl.QRCodeController
ui.EntrantActivity ..> ctl.EntrantController
ui.EntrantEditActivity ..> ctl.EntrantController
ui.OrganizerActivity ..> db.EventDB
ui.AccountSettingsActivity ..> db.ProfileDB
ui.AccountSettingsActivity ..> db.EventDB
ui.AccountSettingsActivity ..> db.WaitingListDB
ui.AccountSettingsActivity ..> db.CommentDB
ui.AccountSettingsActivity ..> ctl.AdminController : invalidate cache
ui.AccountSettingsActivity ..> uiAdmin.AdminActivity : admin device only
ui.NotificationsActivity ..> db.NotificationDB
uicomments.EventCommentsUiBinder ..> db.CommentDB
uicomments.EventCommentsUiBinder ..> db.EventDB
uicomments.EventCommentsUiBinder ..> ui.EventListActivity : browse cards
uicomments.EventCommentsUiBinder ..> ui.QRScanActivity : QR popup card

uiAdmin.AdminActivity ..> ctl.AdminController
uiAdmin.AdminCommentsActivity ..> ctl.AdminController
uiAdmin.AdminAdapter ..> model.Event
uiAdmin.AdminAdapter ..> model.Entrant

adapter.EventAdapter ..> model.Event
adapter.EventAdapter ..> uicomments.EventCommentsUiBinder
adapter.OrganizerEventAdapter ..> model.Event
adapter.EventHistoryAdapter ..> model.Event
adapter.WaitlistEntrantAdapter ..> model.WaitingList
adapter.NotificationListAdapter ..> model.Notification

' ==============================================================================
' Notes on design choices
' ==============================================================================
note as N1
  Models are plain Java objects aligned with Firestore serialization
  (no-arg constructors, getters/setters). Controllers keep UI free of
  persistence details where possible; some screens use DB helpers directly.
end note

note as N2
  Notification flow: waitlist changes write WaitingListDB / NotificationDB.
  TYPE_EVENT_ALERT is used for organizer “notify waitlisted” and admin
  event deletion alerts. recipient_mode distinguishes user vs organizer rows.
end note

model.Event .. N1
ctl.NotificationController .. N2

note as N3
  Account Settings: EntrantDB (local) + ProfileDB (remote); account deletion
  runs organizer pass on events (cascade or co-org) then waitlist removal
  and profile delete. Admin dashboard row (same card as account mode) when
  device ID matches AdminConfig.ADMIN_DEVICE_ID.
end note

ui.AccountSettingsActivity .. N3

note as N4
  Comments live under events/{eventId}/comments (+ replies). EventCommentsUiBinder
  verifies event on server before writes on browse/QR cards; private events block
  non–waitlisted users with the same rules as join.
end note

uicomments.EventCommentsUiBinder .. N4

@enduml
