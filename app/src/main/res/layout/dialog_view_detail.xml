<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_rounded">

    <!-- Dark header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D1B2A"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Type badge -->
        <TextView
            android:id="@+id/tvDetailType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EVENT"
            android:textColor="#9CA3AF"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textAllCaps="true"
            android:layout_marginBottom="6dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp" />

        <!-- Subtitle (description / email) -->
        <TextView
            android:id="@+id/tvDetailSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8899AA"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

    <!-- Profile image (shown for profiles/organizers) -->
    <ImageView
        android:id="@+id/ivDetailImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="-8dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="Profile picture" />

    <!-- Content rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <!-- Divider row: Detail -->
        <LinearLayout
            android:id="@+id/rowDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDetailDetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schedule"
                android:textSize="11sp"
                android:textColor="#9CA3AF"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:layout_marginBottom="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F3F4F6"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDetailDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#374151"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Divider row: Meta -->
        <LinearLayout
            android:id="@+id/rowMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvDetailMetaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Details"
                android:textSize="11sp"
                android:textColor="#9CA3AF"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:layout_marginBottom="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F3F4F6"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDetailMeta1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#374151"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/tvDetailMeta2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#374151"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/btnDetailClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CLOSE"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0D1B2A"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

    </LinearLayout>

</LinearLayout>