<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="2dp"
                android:color="@color/edit_event_input_focus_ring" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/edit_event_input_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/edit_event_input_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/edit_event_input_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/edit_event_input_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
