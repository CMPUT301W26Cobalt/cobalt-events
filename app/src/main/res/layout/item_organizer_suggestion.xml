<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_attendee_tab_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_suggestion_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/event_manage_title"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/tv_suggestion_device_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/event_manage_meta"
        android:textSize="11sp" />
</LinearLayout>
