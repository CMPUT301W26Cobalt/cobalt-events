<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CobaltEvents" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_user</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/page_background</item>
    </style>

    <style name="Widget.CobaltEvents.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="thumbTint">@color/thumb_white</item>
        <item name="track">@drawable/switch_track_pill</item>
        <item name="trackTint">@color/switch_track_selector</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">28dp</item>
    </style>

    <style name="AdminTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:gravity">center</item>
    </style>
</resources>