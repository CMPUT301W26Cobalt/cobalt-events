<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Avatar container -->
        <FrameLayout
            android:id="@+id/adminItemAvatarContainer"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone">

            <!-- Initials circle — admin theme color -->
            <TextView
                android:id="@+id/adminItemInitials"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_admin_icon" />

            <!-- Profile picture (shown when URL available) -->
            <ImageView
                android:id="@+id/adminItemAvatar"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Profile picture" />

        </FrameLayout>

        <!-- Text content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Badge -->
            <TextView
                android:id="@+id/adminItemBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_tag_teal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/adminItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/adminItemSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/adminItemDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <!-- Meta row -->
            <LinearLayout
                android:id="@+id/adminItemMetaRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/adminItemMeta1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/adminItemMeta2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#9CA3AF" />

            </LinearLayout>

            <!-- Image preview (hidden for profile/organizer items) -->
            <ImageView
                android:id="@+id/adminItemImage"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:contentDescription="Item image" />

        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/adminItemViewButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="View details"
                android:padding="6dp" />

            <ImageButton
                android:id="@+id/adminItemDeleteButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_delete"
                android:contentDescription="Delete"
                android:padding="6dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>