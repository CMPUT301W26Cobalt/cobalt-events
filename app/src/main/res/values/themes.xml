<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CobaltEvents" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorPrimaryDark">#1B5E20</item>
        <item name="colorAccent">#4CAF50</item>
        <item name="android:windowBackground">#F0F4F0</item>
    </style>

    <style name="AdminTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:gravity">center</item>
    </style>
</resources>