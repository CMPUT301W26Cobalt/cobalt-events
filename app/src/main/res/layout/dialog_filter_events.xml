<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- Title row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Filter Events"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <ImageButton
            android:id="@+id/btn_close_filter"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#888888"
            android:contentDescription="Close" />
    </RelativeLayout>

    <!-- Category -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="6dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="16dp">
        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingStart="12dp"
            android:paddingEnd="40dp" />
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:src="@android:drawable/arrow_down_float"
            android:tint="#888888"
            android:contentDescription="Dropdown" />
    </RelativeLayout>

    <!-- Date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="6dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="16dp">
        <Spinner
            android:id="@+id/spinner_date"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingStart="12dp"
            android:paddingEnd="40dp" />
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:src="@android:drawable/arrow_down_float"
            android:tint="#888888"
            android:contentDescription="Dropdown" />
    </RelativeLayout>

    <!-- Availability -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Availability"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="6dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="24dp">
        <Spinner
            android:id="@+id/spinner_availability"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingStart="12dp"
            android:paddingEnd="40dp" />
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:src="@android:drawable/arrow_down_float"
            android:tint="#888888"
            android:contentDescription="Dropdown" />
    </RelativeLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_apply_filters"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="APPLY FILTERS"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_button_green_pill"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/btn_clear_filters"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="CLEAR FILTERS"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#444444"
            android:gravity="center"
            android:background="@null" />

    </LinearLayout>

</LinearLayout>
